#!/usr/bin/env python3
# Stands in for wc2bne, pkexec and others: records its arguments, then answers as the test asked.
import os
import signal
import sys
import time

stub = os.environ["STUB"]
name = os.path.basename(sys.argv[0])
args = sys.argv[1:]
if name != "wc2bne":
    args = [name] + args
with open(os.path.join(stub, "ran"), "a", encoding="utf-8") as f:
    f.write("\x1f".join(a.replace("\n", "\\n") for a in args) + "\n")


def interrupted(*_):
    with open(os.path.join(stub, "interrupted"), "a") as f:
        f.write(args[0] + "\n")
    os._exit(130)


signal.signal(signal.SIGINT, interrupted)
data = sys.stdin.read()
if data:
    with open(os.path.join(stub, "input-" + "-".join(args[:2])), "w", encoding="utf-8") as f:
        f.write(data)
answers = os.path.join(stub, "answers")
keys = ["-".join(args[:n]) for n in (3, 2, 1)]
key = next((k for k in keys if os.path.exists(os.path.join(answers, k + ".out"))), None)
if key is None:
    sys.exit(0)
base = os.path.join(answers, key)


def read(kind):
    with open(base + "." + kind, encoding="utf-8") as f:
        return f.read()


out, err, code = read("out"), read("err"), int(read("code"))
sys.stdout.write(out)
sys.stdout.flush()
while os.path.exists(base + ".hold"):
    if os.path.exists(base + ".more"):
        sys.stdout.write(read("more"))
        sys.stdout.flush()
        os.remove(base + ".more")
    time.sleep(0.02)
if key == "play":
    with open(os.path.join(stub, "play-ended"), "w") as f:
        f.write("yes")
sys.stderr.write(err)
sys.exit(code)
